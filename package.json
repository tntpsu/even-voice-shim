{
  "name": "even-voice-shim",
  "version": "0.2.0",
  "description": "Push-to-talk voice transcription shim for Even Realities G2 plugins. Workaround for the missing on-device STT API in @evenrealities/even_hub_sdk.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "author": "Phil Tullai",
  "keywords": [
    "even-realities",
    "even-hub",
    "g2",
    "smart-glasses",
    "speech-to-text",
    "stt",
    "voice",
    "vad",
    "ptt"
  ]
}
